# Mercora International - Apache URL Rewriting for Clean Extension-less URLs
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Redirect direct requests for .php files to extension-less URLs
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php[\s?] [NC]
    RewriteRule ^ %1 [R=301,L]

    # 2. If the request is for an existing file or directory, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Clean URL rewrites: map extension-less requests to .php files if they exist
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f
    RewriteRule ^([^/]+)/?$ $1.php [L,QSA]

    # 4. Aliases and legacy routes mapping
    RewriteRule ^home/?$ index.php [L,QSA]
    RewriteRule ^abouts/?$ about.php [L,QSA]
    RewriteRule ^services/?$ it-services.php [L,QSA]
    RewriteRule ^solutions/?$ business-solutions.php [L,QSA]
    RewriteRule ^support/?$ customer-support.php [L,QSA]
    RewriteRule ^faq/?$ customer-support.php [L,QSA]
    RewriteRule ^coffee/?$ coffee-products.php [L,QSA]
    RewriteRule ^partners/?$ partnerships.php [L,QSA]

    # 5. Fallback router for front controller / 404
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ router.php [L,QSA]
</IfModule>

# Custom Error Pages
ErrorDocument 404 /404.php

# Security & Cache Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
