# Mercora International - Apache URL Rewriting for Clean Extension-less URLs
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. API Endpoints: Pass API requests directly without any trailing-slash or extension redirect
    RewriteRule ^api/enquiry(\.php)?/?$ api/enquiry.php [L,QSA]

    # 2. Redirect /index.php to root /
    RewriteCond %{THE_REQUEST} ^GET\s+/index\.php[\s?] [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    # 3. Redirect direct GET requests for .php files to extension-less URLs
    # CRITICAL: Do NOT redirect POST requests (prevents browsers from converting POST to GET and losing payload)
    # CRITICAL: Exclude /api/ and test utilities from redirect
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{REQUEST_URI} !^/api/ [NC]
    RewriteCond %{REQUEST_URI} !^/test_mail\.php [NC]
    RewriteCond %{THE_REQUEST} ^GET\s+([^.]+)\.php[\s?] [NC]
    RewriteRule ^ %1 [R=301,L,QSA]

    # 4. If the request is for an existing file or directory, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 5. Clean URL rewrites: map extension-less requests to .php files if they exist
    RewriteCond %{REQUEST_FILENAME}.php -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f
    RewriteRule ^([^/]+)/?$ $1.php [L,QSA]

    # 6. Aliases and legacy routes mapping
    RewriteRule ^home/?$ index.php [L,QSA]
    RewriteRule ^abouts/?$ about.php [L,QSA]
    RewriteRule ^services/?$ it-services.php [L,QSA]
    RewriteRule ^solutions/?$ business-solutions.php [L,QSA]
    RewriteRule ^support/?$ customer-support.php [L,QSA]
    RewriteRule ^faq/?$ customer-support.php [L,QSA]
    RewriteRule ^coffee/?$ coffee-products.php [L,QSA]
    RewriteRule ^partners/?$ partnerships.php [L,QSA]
    RewriteRule ^smart-crop-doctor/?$ smart-crop-doctor/index.php [L,QSA]
    RewriteRule ^crop-doctor/?$ smart-crop-doctor/index.php [L,QSA]
    RewriteRule ^white-world/?$ white-world/index.php [L,QSA]
    RewriteRule ^vetigo-mobicare/?$ vetigo-mobicare/index.php [L,QSA]
    RewriteRule ^vetigo/?$ vetigo-mobicare/index.php [L,QSA]

    # 6. Fallback router for front controller / 404
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ router.php [L,QSA]
</IfModule>

# Custom Error Pages
ErrorDocument 404 /404.php

# Security & Cache Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
